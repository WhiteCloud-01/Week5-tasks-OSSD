matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

# Extract the primary diagonal elements (top-left to bottom-right)
diagonal = [matrix[i][i] for i in range(len(matrix))]

# Flatten the matrix into a single 1D list containing only even numbers
evens = [num for row in matrix for num in row if num % 2 == 0]

print(f"Diagonal: {diagonal}")
print(f"Evens: {evens}")
